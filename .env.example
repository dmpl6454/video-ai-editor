ANTHROPIC_API_KEY=
WHISPER_MODEL=small
# NOTE: this file must stay ASCII-only. It is read with the locale encoding in
# places, so a non-ASCII character makes it undecodable on a cp1252 Windows box.
#
# WHISPER_DEVICE: auto | cpu | cuda   ("mps" is accepted but ctranslate2 has no
# Metal backend, so on a Mac it means cpu.)
#
# `auto` PROBES for an NVIDIA GPU and uses it when one is usable. Worth having:
# measured on 60s of Hindi with large-v3, decode ran 95.2s on CPU int8 and 8.4s
# on CUDA float16 for the SAME transcript, so a 3-minute video goes from about
# 9.3 minutes to about 25 seconds. The GPU path needs CUDA's math libraries as
# well as the driver: `uv sync --group cuda`. Without them the app falls back to
# CPU and logs which library was missing.
WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE: override the per-device default (cpu -> int8,
# cuda -> float16). int8_float16 halves VRAM on a small card and measured
# slightly FASTER here (6.6s vs 8.4s) for one word of difference.
# WHISPER_COMPUTE_TYPE=
# VAI_WHISPER_BATCH_SIZE: chunks decoded per forward pass; 0 forces the old
# sequential path. Batching measured 1.95x faster (95.2s vs 185.6s for 60s) AND
# more faithful on code-switched speech: it writes the speaker's English
# loanwords in Latin script where sequential transliterates them into Devanagari.
# VAI_WHISPER_BATCH_SIZE=8
CLAUDE_MODEL=claude-sonnet-4-6
WORKDIR=workdir
