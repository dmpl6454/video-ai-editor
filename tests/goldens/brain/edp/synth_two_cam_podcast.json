g at 2:26"},"ref":{"src":"src_e20000000000000000000002","t0":146.3667,"t1":154.2667},"score":0.9},{"by":"recipes","confidence":0.85,"id":"k_0027","kind":"switch_angle","optional":false,"params":{"angle":"src_e20000000000000000000003","angle_src":"src_e20000000000000000000003","letter":"B","ref":[155.8167,158.5834],"speaker":"S2"},"produced":null,"reason":{"code":"speaker_turn","facts":["u_0036","S2"],"text":"Cut to the guest, who starts speaking at 2:35"},"ref":{"src":"src_e20000000000000000000002","t0":156.1667,"t1":158.9334},"score":0.9},{"by":"recipes","confidence":0.85,"id":"k_0028","kind":"switch_angle","optional":false,"params":{"angle":"src_e20000000000000000000003","angle_src":"src_e20000000000000000000003","letter":"B","ref":[160.8167,165.3834],"speaker":"S2"},"produced":null,"reason":{"code":"speaker_turn","facts":["u_0038","S2"],"text":"Cut to the guest, who starts speaking at 2:40"},"ref":{"src":"src_e20000000000000000000002","t0":161.1667,"t1":165.7334},"score":0.9},{"by":"recipes","confidence":0.8,"id":"k_0029","kind":"jump_cut_hide","optional":true,"params":{"from_scale":1.0,"interp":"step","keys":[{"interp":"step","t":42.0834,"values":{"scale":1.08,"x":0.0,"y":0.0}},{"interp":"step","t":42.1501,"values":{"scale":1.08,"x":0.0,"y":0.0}}],"piece":[42.0834,49.4334],"props":["scale","x","y"],"scale":1.08,"step":0.08},"produced":null,"reason":{"code":"jump_cut_hide","facts":["sil_0008"],"text":"Stepped the zoom from 100% to 108% at 0:41 so the jump does not show"},"ref":{"src":"src_e20000000000000000000002","t0":42.0834,"t1":42.1167},"score":0.7},{"by":"recipes","confidence":0.8,"id":"k_0030","kind":"jump_cut_hide","optional":true,"params":{"from_scale":1.0,"interp":"step","keys":[{"interp":"step","t":87.75,"values":{"scale":1.08,"x":0.0,"y":0.0}},{"interp":"step","t":87.8167,"values":{"scale":1.08,"x":0.0,"y":0.0}}],"piece":[87.75,97.8666],"props":["scale","x","y"],"scale":1.08,"step":0.08},"produced":null,"reason":{"code":"jump_cut_hide","facts":["d_0001","s_00022"],"text":"Stepped the zoom from 100% to 108% at 1:27 so the jump does not show"},"ref":{"src":"src_e20000000000000000000002","t0":87.75,"t1":87.7833},"score":0.7},{"by":"recipes","confidence":1.0,"id":"k_0031","kind":"captions","optional":false,"params":{"cues":[{"spk":"S1","t0":0.6,"t1":2.28,"text":"Welcome back to the show,"},{"spk":"S1","t0":2.63,"t1":4.795,"text":"where today we are talking about"},{"spk":"S1","t0":4.865,"t1":7.21,"text":"raising money for\na hardware company."},{"spk":"S2","t0":7.71,"t1":11.725,"text":"Thanks for having me, it is\na strange business to fund."},{"spk":"S1","t0":12.225,"t1":15.46,"text":"So let's start at the\nbeginning, why hardware?"},{"spk":"S2","t0":15.96,"t1":18.385,"text":"Because nobody else\nwanted to do it,"},{"spk":"S2","t0":18.735,"t1":20.9,"text":"and the margins\nin hardware were,"},{"spk":"S2","t0":21.79,"t1":22.25,"text":"terrible."},{"spk":"S2","t0":23.24,"t1":25.835,"text":"So we built the\nfirst prototype in a"},{"spk":"S2","t0":25.905,"t1":28.6,"text":"garage and shipped it\nto twelve customers."},{"spk":"S1","t0":29.1,"t1":31.94,"text":"Twelve customers, how\ndid you find them?"},{"spk":"S2","t0":32.44,"t1":35.09,"text":"The thing nobody tells\nyou about raising"},{"spk":"S2","t0":35.16,"t1":38.365,"text":"money is that the first\nno is the useful one."},{"spk":"S2","t0":38.865,"t1":40.96,"text":"It nearly broke us, honestly."},{"spk":"S2","t0":41.96,"t1":45.04,"text":"But it also told us\nexactly what was missing."},{"spk":"S2","t0":46.12,"t1":48.85,"text":"We rewrote the whole\npitch in a weekend."},{"spk":"S1","t0":50.65,"t1":54.905,"text":"So what did the second pitch\nsay that the first one did not?"},{"spk":"S2","t0":55.405,"t1":55.945,"text":"It said,"},{"spk":"S2","t0":56.835,"t1":59.125,"text":"we had a customer\nwho paid twice."},{"spk":"S2","t0":60.25,"t1":63.465,"text":"That single number did\nmore than the whole deck."},{"spk":"S1","t0":64.505,"t1":66.355,"text":"Let me ask about the team."},{"spk":"S2","t0":67.205,"t1":68.07,"text":"Sure, go ahead."},{"spk":"S1","t0":68.57,"t1":71.255,"text":"How many people were\nyou at that point?"},{"spk":"S2","t0":71.755,"t1":76.325,"text":"Three of us in 2019, and then\neight by the end of the year."},{"spk":"S1","t0":78.44,"t1":80.685,"text":"When did the first hire come in?"},{"spk":"S2","t0":81.185,"t1":84.885,"text":"About six months later we hired\na manufacturing lead first,"},{"spk":"S2","t0":87.635,"t1":89.765,"text":"which everybody\nsaid was backwards."},{"spk":"S2","t0":90.265,"t1":93.805,"text":"But the product was the\nbottleneck, not the sales."},{"spk":"S2","t0":94.885,"t1":97.515,"text":"And that decision\nis the reason we are"},{"spk":"S1","t0":97.515,"t1":97.64,"text":"Let"},{"spk":"S2","t0":97.64,"t1":97.82,"text":"still"},{"spk":"S1","t0":97.82,"t1":98.035,"text":"me"},{"spk":"S2","t0":98.035,"t1":98.085,"text":"here."},{"spk":"S1","t0":98.08,"t1":102.41,"text":"push back on that, because most\nfounders say hire sales first."},{"spk":"S2","t0":102.91,"t1":105.785,"text":"They do, and most\nof them are selling"},{"spk":"S2","t0":105.855,"t1":108.065,"text":"something that\ndoes not exist yet."},{"spk":"S1","t0":108.565,"t1":109.895,"text":"That is fair enough."},{"spk":"S1","t0":110.395,"t1":112.165,"text":"What was the hardest month?"},{"spk":"S2","t0":113.065,"t1":114.745,"text":"March of the second year,"},{"spk":"S2","t0":115.095,"t1":119.395,"text":"we had four weeks of cash and\na factory asking for a deposit."},{"spk":"S1","t0":119.895,"t1":121.045,"text":"What did you do?"},{"spk":"S2","t0":121.545,"t1":124.85,"text":"We called every customer\nand asked them to prepay,"},{"spk":"S2","t0":125.2,"t1":126.7,"text":"and nine of them did."},{"spk":"S1","t0":127.2,"t1":128.7,"text":"Nine out of how many?"},{"spk":"S2","t0":129.55,"t1":132.04,"text":"Twelve, the same\ntwelve from the garage."},{"spk":"S1","t0":133.84,"t1":136.23,"text":"That is a remarkable\nretention number."},{"spk":"S2","t0":136.73,"t1":140.5,"text":"It is the only number we\nput on the first slide now."},{"spk":"S1","t0":141.54,"t1":145.61,"text":"Before we wrap, what would you\ntell someone starting today?"},{"spk":"S2","t0":146.11,"t1":148.715,"text":"Ship to real customers\nbefore you raise,"},{"spk":"S2","t0":149.065,"t1":151.365,"text":"because the money\nfollows the proof,"},{"spk":"S2","t0":151.715,"t1":153.485,"text":"never the other way around."},{"spk":"S1","t0":153.985,"t1":155.405,"text":"Ship before you raise."},{"spk":"S2","t0":155.905,"t1":158.17,"text":"Exactly that, and do it early."},{"spk":"S1","t0":158.67,"t1":160.395,"text":"Where can people find you?"},{"spk":"S2","t0":160.895,"t1":164.955,"text":"On the website, and the product\nis in stores next month."},{"spk":"S1","t0":165.455,"t1":168.635,"text":"Thank you for coming\non, that is the show."}],"look":{"background":"#000000AA","size":56,"upper":false},"max_chars":32,"mode":"podcast","position":"bottom","src":"src_e20000000000000000000002","style":"default"},"produced":null,"reason":{"code":"caption_mode","facts":[],"text":"Added Podcast captions: clean readable lines, one person at a time"},"ref":null,"score":1.0},{"by":"recipes","confidence":1.0,"id":"k_0032","kind":"dialogue","optional":false,"params":{"lane":"a1","mute_camera_mics":true,"offsets":{"src_e20000000000000000000001":0.0,"src_e20000000000000000000002":0.35,"src_e20000000000000000000003":-0.2},"seam_fade_s":0.005,"src":"src_e20000000000000000000001"},"produced":null,"reason":{"code":"dialogue_lane","facts":["src_e20000000000000000000001"],"text":"Dialogue now plays from the recorder on its own audio lane, the camera microphones muted; 25 cuts get a 5 ms fade so none clicks"},"ref":null,"score":1.0}],"graph":{"digest":"sha256:audio=sha256:9bb38c008b5ad1e4b7303da5ced4f5cb7cfb9874068","id":"g_66bbd4184437"},"id":"d_d0d6f8dd","planner_version":2,"previous":null,"scope":null,"score":null,"seed":0,"style":"premium_podcast","summary":{"camera":{"an